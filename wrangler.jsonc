{
  // Set the D1 database_id to your actual database ID before deploying.
  "name": "safekey-nigeria",
  "main": "src/worker.js",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safekey-nigeria",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  }
}
