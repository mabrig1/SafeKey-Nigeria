{
  // Replace the D1 database_id with the real Cloudflare D1 ID before deployment.
  "name": "safekey-nigeria",
  "main": "src/worker.js",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Route all responses through the Worker so the CSP and other headers apply.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safekey-nigeria",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  }
}
